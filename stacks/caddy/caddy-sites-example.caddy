*.example.com {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    propagation_delay 2m
    resolvers 1.1.1.1
  }

  # Web app; point this at the app port on the VPS.
  @app host app.example.com
  handle @app {
    reverse_proxy 127.0.0.1:3000 {
      header_up -X-Forwarded-For
    }
  }

  # REST API; point this at the API port on the VPS.
  @api host api.example.com
  handle @api {
    reverse_proxy 127.0.0.1:8080 {
      header_up -X-Forwarded-For
    }
  }

  # Files on the host in /data/www/blog are mounted at /srv/blog.
  @blog host blog.example.com
  handle @blog {
    root * /srv/blog
    file_server
  }
}
